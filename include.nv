proto int sys socket(int,int,int)
proto void sys bind(int,any,int)
proto int sys accept(int,any,int)
proto int sys connect(int,any,int)
proto void sys listen(int,int)
proto int sys setsockopt(int,int,int,any,int)
proto void sys close(int)
proto void sys send(int,any,i64,int)

proto int c_socket(int,int,int)
proto any bind_ipv4(int, str, int)
proto int net_accept(int,any)
proto void c_listen(int)
proto void reuseaddr(int)
proto void c_send(int,str)
proto void c_sendchar(int,char[])
proto void c_close(int)
proto int c_connect(int, str, int)

class TcpListener
	int fd, socket
	any addr_st
	str ip
	ctor(str ip)
		print("Start connection: ", ip)
		# AF_INET=2 (ipv4)
		# SOCK_STREAM=1 (TCP)
		self.fd = c_socket(2,1,0)
		reuseaddr(self.fd)
		self.addr_st = bind_ipv4(self.fd, ip, 8080)
		c_listen(self.fd)

	def void accept()
		self.socket = net_accept(self.fd, self.addr_st)

	def TcpStream get_stream()
		return new TcpStream(self.socket)


class TcpStream
	int socket
	ctor(int client_fd)
		self.socket = client_fd
		
	def void read(char[] buf, int size)
        i64 msg_size = c_read(self.socket, buf, size - 1)
		print("read size: ", msg_size)
        if msg_size >= 0
            buf[msg_size] = '\0'
        else
            buf[0] = '\0'		

	def void close()
		c_close(self.socket)

	def void send(str msg)
		print("send as str")
		c_send(self.socket, msg)

	def void sendchar(char[] msg)
		print("AS A CHAR")
		c_sendchar(self.socket, msg)
	
	def void disown()
		c_close(self.socket)




class NetServer
	str ip
	TcpListener listener
	ctor(str ip)
		self.listener = new TcpListener(ip)
	def void start(Function<void,TcpStream> myfn)
		int i=0
		while i<5000
			i = i + 1
			print("conn: ", i)
			self.listener.accept()
			var conn = self.listener.get_stream()
			spawn myfn(conn)
		print("sleep")
		sleep(5)


class NetClient
    int socket
    str target_ip
    
    ctor(str target_ip)
        print("Connecting to: ", target_ip)
        self.socket = c_socket(2,1,0)
        
        # Call connect to reach out to the laptop's server
        int result = c_connect(self.socket, target_ip, 8080)
        if result < 0
            print("Connection failed!")
        else
            print("Connected successfully!")
            
    def void read(char[] buf, int size)
        i64 msg_size = c_read(self.socket, buf, size)
		if msg_size < size
			buf[msg_size] = '\0'


    def void send(str msg)
		print("client send")
        c_send(self.socket, msg)

	def void disown()
		c_close(self.socket)
